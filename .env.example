# ---- Backend ----
# Comma-separated Gemini API keys -> key_1, key_2 (at least 2 required for /health = ok)
LLM_API_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2
# LiteLLM model string
GEMINI_MODEL=gemini/gemini-3.5-flash-lite
# SQLite path (inside the container, /data is a named volume)
DATABASE_URL=sqlite:////data/app.db
# CORS origins, comma-separated (use your deployed frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000
# Enables the X-Simulate-Failure request header
ENABLE_FAILURE_SIMULATION=true

# ---- Frontend (build-time) ----
VITE_API_BASE_URL=http://localhost:8000
